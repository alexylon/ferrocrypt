/target
**/.idea
dest*
.DS_Store
.sofos/
.claude/
.notes/
__pycache__/

# Test scratch workspaces created at runtime and removed by each test
# binary's exit hook (see TEST_WORKSPACE_ROOTS in run_all_tests.sh). Ignored
# so a run killed before that hook runs — a CI timeout, Ctrl-C, an OOM kill —
# cannot leave scratch files staged for commit, including the multi-GiB
# payload the large-file test writes.
**/tests/workspace*/
**/tests/cli_workspace*/
