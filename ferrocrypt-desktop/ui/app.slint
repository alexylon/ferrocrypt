// FerroCrypt Slint GUI — Dark Security Theme

// Mode codes shared with the Rust side (see MODE_* constants in main.rs).
global Mode {
    out property <int> passphrase-encrypt: 0;
    out property <int> passphrase-decrypt: 1;
    out property <int> recipient-encrypt: 2;
    out property <int> recipient-decrypt: 3;
    out property <int> keygen: 4;
}

global Theme {
    // Backgrounds
    out property <color> bg: #0a0f1a;
    out property <color> surface: #111827;
    out property <color> surface-hover: #1c2536;
    out property <color> input-bg: #0f172a;

    // Borders
    out property <color> border: #1e293b;
    out property <color> border-hover: #334155;
    out property <color> border-focus: #06b6d4;

    // Disabled
    out property <color> input-bg-disabled: #0b0f1c;

    // Text
    out property <color> text: #e2e8f0;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-dim: #64748b;
    out property <color> text-disabled: #475569;
    out property <color> text-off: #334155;

    // Accents
    out property <color> accent: #06b6d4;
    out property <color> accent-muted: #164e63;
    out property <color> accent-btn: #0e7490;
    out property <color> accent-btn-hover: #0891b2;

    // Status
    out property <color> success: #34d399;
    out property <color> error: #f87171;
    out property <color> warning: #d4a053;
    out property <color> info: #60a5fa;

    // Notification bar
    out property <color> notify-error-bg: #1c1012;
    out property <color> notify-error-border: #3b1520;
    out property <color> notify-warning-bg: #1a1708;
    out property <color> notify-warning-border: #3b3015;
    out property <color> notify-success-bg: #0a1a14;
    out property <color> notify-success-border: #153b2a;

    // Info panel (fingerprint)
    out property <color> info-bg: #0a1420;
    out property <color> info-border: #152a3b;

    // Font sizes
    out property <length> font-title: 20px;
    out property <length> font-action: 14px;
    out property <length> font-body: 12.5px;
    out property <length> font-caption: 10.5px;

    // Font weights
    out property <int> weight-normal: 400;
    out property <int> weight-medium: 600;
    out property <int> weight-bold: 700;

    // Corner radii (outer to inner)
    out property <length> radius-lg: 6px;
    out property <length> radius-md: 5px;
    out property <length> radius-sm: 4px;

    // Border
    out property <length> hairline: 1px;

    // Animation durations
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-base: 150ms;
    out property <duration> dur-slow: 200ms;

    // Spacing
    out property <length> gap-2xs: 2px;
    out property <length> gap-xs: 3px;
    out property <length> gap-sm: 4px;
    out property <length> label-gap: 5px;
    out property <length> row-spacing: 6px;
    out property <length> gap-md: 8px;
    out property <length> field-pad: 10px;
    out property <length> notify-pad: 6px;
    out property <length> gap-lg: 13px;
    out property <length> gap-xl: 14px;
    out property <length> field-gap: 18px;
    out property <length> gap-2xl: 22px;
    out property <length> gap-3xl: 28px;

    // Dimensions
    out property <length> field-height: 34px;
    out property <length> ctl-height: 30px;
    out property <length> mode-height: 38px;
    out property <length> action-height: 40px;
    out property <length> reset-width: 54px;
    out property <length> btn-width: 56px;
    out property <length> icon-btn: 22px;
    out property <length> icon: 11px;
    out property <length> icon-stroke: 1.5px;
    // Heavier than `icon-stroke`: the password match mark is read at a glance.
    out property <length> match-stroke: 2px;
    out property <length> focus-ring: 2px;
    // Wide enough for "Strong" in the system fonts, so the meter beside it
    // keeps its length whatever the label says.
    out property <length> strength-label-w: 40px;
    out property <length> window-w: 450px;
    out property <length> window-h: 700px;

    // The app's own window frame, drawn where the system draws none
    out property <length> title-bar-h: 35px;
    out property <length> window-radius: 12px;
    out property <length> title-icon: 8px;

    // Lets the form's gaps shrink when a mode needs more height than the
    // fixed window has. The layout was tuned against the macOS system font,
    // so macOS keeps rigid gaps; elsewhere, fonts with taller lines need
    // this in Create key pair mode.
    out property <bool> flexible-gaps: Platform.os != OperatingSystemType.macos;
}

// ---------------------------------------------------------------------------
// Reusable: space above a form section
// ---------------------------------------------------------------------------
// Its height is `gap`. With `Theme.flexible-gaps`, it can shrink to `least`
// when the form needs more height than the window has.
component FieldGap inherits Rectangle {
    in property <length> gap: Theme.field-gap;
    in property <length> least: Theme.gap-md;
    min-height: Theme.flexible-gaps ? self.least : self.gap;
    preferred-height: self.gap;
    max-height: self.gap;
}

// ---------------------------------------------------------------------------
// Reusable: a control the mouse, the keyboard, and assistive technology press
// ---------------------------------------------------------------------------
// A click presses it, so do Space and Enter once Tab has moved the focus to
// it, and so does assistive technology's default action; each calls `pressed`
// while the control is enabled. Set `accessible-label` to the control's name.
// The focus is taken by a scope that takes no clicks, so a click does not
// move it and the ring that shows it, `ring-inset` inside the control's edge,
// appears only for keyboard use. Assistive technology announces the focus as
// this control, the nearest accessible element around it.
component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <length> ring-inset: 0;
    in property <color> ring-color: Theme.border-focus;
    // Whether Tab stops here.
    in property <bool> tab-stop: true;
    in property <MouseCursor> cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
    // A turned-off control ignores the pointer, so its last hover would
    // otherwise stay.
    out property <bool> has-hover: ta.has-hover && root.enabled;
    callback pressed();

    function press() {
        if (root.enabled) {
            root.pressed();
        }
    }

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.press();
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.cursor;
        clicked => {
            root.press();
        }
    }

    @children

    // A disabled scope would miss losing the focus, and then show a ring
    // that is no longer true, so a turned-off control leaves the Tab order
    // instead. One turned off while it has the focus keeps its ring until
    // Tab moves on, so the focus is never out of sight.
    focus := FocusScope {
        x: 0;
        width: 0;
        focus-on-tab-navigation: root.enabled && root.tab-stop;
        // Like a native button, the control is pressed when the key comes
        // back up, so a held key presses once and a dialog the press opens
        // does not receive the key.
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.press();
                return accept;
            }
            reject
        }
    }

    if focus.has-focus: focus-ring := Rectangle {
        x: root.ring-inset;
        y: root.ring-inset;
        width: parent.width - 2 * root.ring-inset;
        height: parent.height - 2 * root.ring-inset;
        border-radius: root.ring-inset > 0 ? Theme.radius-sm : root.border-radius;
        border-width: Theme.focus-ring;
        border-color: root.ring-color;
    }
}

// ---------------------------------------------------------------------------
// Reusable: small outline button
// ---------------------------------------------------------------------------
// `label` is what the button shows; set `accessible-label` as well where the
// label alone does not say what the button chooses.
component SmallButton inherits Pressable {
    in property <string> label;

    height: Theme.field-height;
    border-radius: Theme.radius-lg;
    background: root.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: Theme.hairline;
    border-color: Theme.border;
    accessible-label: root.label;
    animate background { duration: Theme.dur-fast; }

    Text {
        text: root.label;
        color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// ---------------------------------------------------------------------------
// Reusable: one choice of a segmented control
// ---------------------------------------------------------------------------
// Grows from no width rather than from its label, so the choices of one
// control are equally wide and keep their width when a bold label moves. A
// press on the active choice does nothing: the form already shows it, and
// choosing it again would reset the form. Each choice switches what the form
// below shows, so assistive technology hears it as a tab.
component Choice inherits Pressable {
    in property <string> label;
    in property <bool> active;
    in property <bool> bold-when-active;
    callback chosen();

    min-width: 0;
    preferred-width: 0;
    horizontal-stretch: 1;
    background: root.active ? Theme.accent-muted : root.has-hover ? Theme.surface-hover : transparent;
    cursor: root.enabled && !root.active ? MouseCursor.pointer : MouseCursor.default;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    animate background { duration: Theme.dur-base; }
    pressed => {
        if (!root.active) {
            root.chosen();
        }
    }

    Text {
        text: root.label;
        color: root.active ? Theme.text : !root.enabled ? Theme.text-off : Theme.text-secondary;
        font-size: Theme.font-body;
        font-weight: root.active && root.bold-when-active ? Theme.weight-medium : Theme.weight-normal;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// ---------------------------------------------------------------------------
// Reusable: password input
// ---------------------------------------------------------------------------
// Masked text never leaves this input: copy and cut do nothing, and where a
// mouse selection would reach the selection clipboard, a click on masked text
// only focuses the input.
component PasswordInput {
    in-out property <string> text;
    // What assistive technology calls the input.
    in property <string> label;
    in property <bool> masked: true;
    in property <bool> enabled: true;
    in property <bool> selection-clipboard: false;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited();
    forward-focus: input;

    // `TextInput` copies and cuts on these keys even when its text is
    // masked. Cmd on macOS reaches Slint as Ctrl.
    pure function is-copy-or-cut(event: KeyEvent) -> bool {
        event.modifiers.control && (event.text.to-lowercase() == "c" || event.text.to-lowercase() == "x")
    }

    // Never takes focus itself, but sees the input's keys first.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (root.masked && root.is-copy-or-cut(event)) {
                return accept;
            }
            reject
        }

        input := TextInput {
            // One line high: at full height, the offset would push the input,
            // and its click area, below the field.
            y: (parent.height - self.preferred-height) / 2;
            height: self.preferred-height;
            color: Theme.text;
            font-size: Theme.font-body;
            text-cursor-width: 2px;
            selection-background-color: Theme.accent;
            input-type: root.masked ? InputType.password : InputType.text;
            accessible-label: root.label;
            text <=> root.text;
            single-line: true;
            enabled: root.enabled;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited();
            }
        }

        // `TextInput` copies a mouse selection to the selection clipboard
        // when the button is released, so this click only focuses the input.
        // It also clears the selection, as a normal click does, so the next
        // key cannot replace hidden text.
        guard := TouchArea {
            x: input.x;
            y: input.y;
            width: input.width;
            height: input.height;
            enabled: root.selection-clipboard && root.masked && root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => {
                input.focus();
                input.clear-selection();
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Reusable: round title bar button
// ---------------------------------------------------------------------------
component TitleButton inherits Pressable {
    in property <string> label;

    width: Theme.icon-btn;
    height: Theme.icon-btn;
    border-radius: self.width / 2;
    background: self.has-hover ? Theme.surface-hover : Theme.surface;
    cursor: MouseCursor.default;
    // Like the buttons of a frame the system draws, these stay out of the Tab
    // order; the system's own keys minimize and close the window.
    tab-stop: false;
    accessible-label: root.label;
    animate background { duration: Theme.dur-fast; }
}

// ---------------------------------------------------------------------------
// Reusable: title bar, for a window whose frame the app draws itself
// ---------------------------------------------------------------------------
// Pressing the bar moves the window, and a right click opens the system's
// window menu. The window has a fixed size, so it offers no maximize button.
component TitleBar inherits Rectangle {
    in property <string> title;
    callback move-window();
    callback show-window-menu(x: length, y: length);
    callback minimize-window();
    callback close-window();

    height: Theme.title-bar-h;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.move-window();
                } else if (event.button == PointerEventButton.right) {
                    root.show-window-menu(self.mouse-x, self.mouse-y);
                }
            }
        }
    }

    Text {
        text: root.title;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        font-weight: Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    minimize-button := TitleButton {
        x: close-button.x - Theme.gap-md - self.width;
        y: (parent.height - self.height) / 2;
        label: "Minimize";
        pressed => {
            root.minimize-window();
        }

        Rectangle {
            width: Theme.title-icon;
            height: Theme.icon-stroke;
            background: Theme.text-secondary;
        }
    }

    close-button := TitleButton {
        x: parent.width - Theme.gap-md - self.width;
        y: (parent.height - self.height) / 2;
        label: "Close";
        pressed => {
            root.close-window();
        }

        Path {
            width: Theme.title-icon;
            height: Theme.title-icon;
            viewbox-width: 1;
            viewbox-height: 1;
            commands: "M 0 0 L 1 1 M 1 0 L 0 1";
            stroke: Theme.text-secondary;
            stroke-width: Theme.icon-stroke;
        }
    }
}

// ---------------------------------------------------------------------------
// Main application window
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    title: app-version != "" ? "FerroCrypt v" + app-version : "FerroCrypt";
    // Where the system draws no frame (GNOME on Wayland, for one), the app
    // draws its own: a title bar and rounded corners. The window is then
    // transparent outside them.
    in property <bool> own-frame: false;
    no-frame: own-frame;
    background: own-frame ? transparent : Theme.bg;
    width: Theme.window-w;
    height: Theme.window-h + frame-top;

    in property <string> app-version;

    // ── State ───────────────────────────────────────────────────────────
    in-out property <int> mode: Mode.passphrase-encrypt;
    in-out property <string> input-path;
    in-out property <string> input-path-display;
    in-out property <string> output-path;
    in-out property <string> output-path-display;
    in-out property <string> password;
    in-out property <string> password-repeated;
    in-out property <string> key-path;
    in-out property <string> key-path-display;
    in-out property <string> keygen-output-dir;
    in-out property <string> keygen-output-dir-display;
    in-out property <string> status-ok;
    in-out property <string> status-err;
    in-out property <bool> hide-password: true;
    in-out property <bool> is-working: false;
    // How much of the encrypted file an operation has handled, from 0 to 1;
    // negative while that is not known, such as during key derivation.
    in-out property <float> progress: -1;
    in-out property <bool> combined-picker: false;
    // True where a mouse selection is copied to the selection clipboard
    // (X11 and Wayland).
    in property <bool> selection-clipboard: false;
    in-out property <string> conflict-warning;
    // Why the source, which opens like an encrypted file, cannot be decrypted;
    // empty for any other source. The Rust side turns it into a warning.
    in-out property <string> input-reason;
    in-out property <int> password-strength: 0;
    in-out property <string> key-fingerprint;
    in-out property <bool> key-invalid: false;

    // ── Derived ─────────────────────────────────────────────────────────
    property <bool> require-password: mode != Mode.recipient-encrypt;
    property <bool> require-password-repeated:
        (mode == Mode.passphrase-encrypt || mode == Mode.keygen) && hide-password;
    property <bool> require-key: mode == Mode.recipient-encrypt || mode == Mode.recipient-decrypt;
    // The password unlocks a private key, or seals a new one.
    property <bool> private-key-password: mode == Mode.recipient-decrypt || mode == Mode.keygen;
    property <string> password-name: private-key-password ? "Private key password" : "Password";
    property <string> password-noun: password-name.to-lowercase();
    property <string> confirm-password-name: "Confirm " + password-noun;
    property <bool> password-match: password == password-repeated;
    property <bool> disable-start: is-working || (mode == Mode.passphrase-encrypt && (input-path == "" || password == "" || (require-password-repeated && !password-match))) || (mode == Mode.passphrase-decrypt && (input-path == "" || password == "")) || (mode == Mode.recipient-encrypt && (input-path == "" || key-path == "" || key-invalid)) || (mode == Mode.recipient-decrypt && (input-path == "" || password == "" || key-path == "" || key-invalid)) || (mode == Mode.keygen && (keygen-output-dir == "" || password == "" || (require-password-repeated && !password-match)));
    property <bool> is-encrypt-mode: mode == Mode.passphrase-encrypt || mode == Mode.recipient-encrypt || mode == Mode.keygen;
    property <bool> form-is-clean:
        (mode == Mode.passphrase-encrypt || mode == Mode.recipient-encrypt) && hide-password && input-path == "" && output-path == "" && password == "" && password-repeated == "" && key-path == "" && keygen-output-dir == "" && conflict-warning == "" && status-ok == "" && status-err == "";
    property <string> button-text:
        mode == Mode.passphrase-encrypt || mode == Mode.recipient-encrypt ? "Encrypt" : mode == Mode.passphrase-decrypt || mode == Mode.recipient-decrypt ? "Decrypt" : "Generate key pair";
    property <color> strength-color:
        password-strength <= 1 ? Theme.error : password-strength == 2 ? Theme.warning : password-strength == 3 ? Theme.info : Theme.success;
    // Where the form starts: below the app's own title bar, if it has one.
    property <length> frame-top: own-frame ? Theme.title-bar-h : 0px;

    // ── Callbacks ───────────────────────────────────────────────────────
    callback mode-changed();
    callback select-input-file();
    callback select-input-folder();
    callback select-key-file();
    callback select-output-dir();
    callback select-output-file();
    callback select-keygen-output-dir();
    callback start-operation();
    callback password-edited();
    // Any other edit typed into the form.
    callback form-edited();
    callback clear-form();
    callback copy-fingerprint();
    // The app's own frame (see `own-frame`)
    callback move-window();
    callback show-window-menu(x: length, y: length);
    callback minimize-window();
    callback close-window();

    // Switches the form to `new-mode`, as a tab or key source does.
    function choose-mode(new-mode: int) {
        root.mode = new-mode;
        root.mode-changed();
    }

    // ── Own frame: background and title bar ─────────────────────────────
    if own-frame: Rectangle {
        background: Theme.bg;
        border-radius: Theme.window-radius;
    }

    if own-frame: title-bar := TitleBar {
        y: 0;
        title: root.title;
        move-window => {
            root.move-window();
        }
        show-window-menu(x, y) => {
            root.show-window-menu(x, y);
        }
        minimize-window => {
            root.minimize-window();
        }
        close-window => {
            root.close-window();
        }
    }

    // ── Accent stripe ───────────────────────────────────────────────────
    Rectangle {
        y: frame-top;
        width: 100%;
        height: 2px;
        background: @linear-gradient(90deg, Theme.bg, Theme.accent 50%, Theme.bg);
    }

    // ── Main layout ─────────────────────────────────────────────────────
    VerticalLayout {
        y: frame-top;
        height: Theme.window-h;
        padding-left: Theme.gap-2xl;
        padding-right: Theme.gap-2xl;
        padding-top: Theme.gap-3xl;
        padding-bottom: Theme.gap-xl;
        spacing: 0px;

        // ── Top section: packs tightly at the top ──
        VerticalLayout {
            spacing: 0px;
            alignment: start;
            // With no stretch, this section shrinks only once the bar below
            // has shrunk to its minimum, so the fields stay in place when a
            // message wraps.
            vertical-stretch: 0;

            // ═══════════ HEADER ═══════════
            Text {
                text: "FerroCrypt";
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
            }

            Rectangle {
                height: Theme.gap-sm;
            }

            Text {
                text: "Secure File Encryption";
                color: Theme.text-dim;
                font-size: Theme.font-body;
                horizontal-alignment: center;
            }

            Rectangle {
                height: Theme.gap-2xl;
            }

            // ═══════════ MODE SELECTOR ═══════════
            Rectangle {
                height: Theme.mode-height;
                border-radius: Theme.radius-lg;
                background: Theme.input-bg;
                border-width: Theme.hairline;
                border-color: Theme.border;
                accessible-role: tab-list;
                accessible-label: "Mode";

                HorizontalLayout {
                    padding: Theme.gap-xs;
                    spacing: Theme.gap-2xs;

                    password-tab := Choice {
                        label: "Password";
                        active: mode == Mode.passphrase-encrypt || mode == Mode.passphrase-decrypt;
                        enabled: mode != Mode.recipient-decrypt && !is-working;
                        bold-when-active: true;
                        border-radius: Theme.radius-md;
                        chosen => {
                            root.choose-mode(Mode.passphrase-encrypt);
                        }
                    }

                    Rectangle {
                        width: Theme.hairline;
                        background: Theme.border;
                    }

                    key-pair-tab := Choice {
                        label: "Key pair";
                        active: mode == Mode.recipient-encrypt || mode == Mode.recipient-decrypt || mode == Mode.keygen;
                        enabled: mode != Mode.passphrase-decrypt && !is-working;
                        bold-when-active: true;
                        border-radius: Theme.radius-md;
                        chosen => {
                            root.choose-mode(Mode.recipient-encrypt);
                        }
                    }
                }
            }

            Rectangle {
                height: Theme.row-spacing;
            }

            Text {
                text: mode == Mode.passphrase-encrypt || mode == Mode.passphrase-decrypt ? "Encrypt and decrypt with a password" : mode == Mode.keygen ? "Generate a key pair" : "Encrypt with a public key, decrypt with a private key";
                color: Theme.text-dim;
                font-size: Theme.font-body;
                horizontal-alignment: center;
                animate color { duration: Theme.dur-base; }
            }

            // ═══════════ INPUT FILE / FOLDER ═══════════
            VerticalLayout {
                spacing: 0px;
                FieldGap { }

                Text {
                    text: "Source file or folder";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                HorizontalLayout {
                    spacing: Theme.row-spacing;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.field-height;
                        border-radius: Theme.radius-lg;
                        background: is-working ? Theme.input-bg-disabled : Theme.input-bg;
                        border-width: Theme.hairline;
                        border-color: !is-working && input-path-ta.has-hover ? Theme.border-hover : Theme.border;
                        clip: true;
                        animate background { duration: Theme.dur-base; }
                        animate border-color { duration: Theme.dur-base; }

                        input-path-ta := TouchArea {
                            enabled: !is-working;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => {
                                root.select-input-file();
                            }
                        }

                        Text {
                            x: Theme.field-pad;
                            width: parent.width - 2 * Theme.field-pad;
                            vertical-alignment: center;
                            text: input-path != "" ? input-path-display : "No file or folder selected";
                            color: input-path != "" ? Theme.text : Theme.text-disabled;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                    }

                    if combined-picker: SmallButton {
                        width: Theme.btn-width;
                        label: "Choose";
                        accessible-label: "Choose source file or folder";
                        enabled: !is-working;
                        pressed => {
                            root.select-input-file();
                        }
                    }
                    if !combined-picker: SmallButton {
                        width: Theme.btn-width;
                        label: "File";
                        accessible-label: "Choose source file";
                        enabled: !is-working;
                        pressed => {
                            root.select-input-file();
                        }
                    }
                    if !combined-picker: SmallButton {
                        width: Theme.btn-width;
                        label: "Folder";
                        accessible-label: "Choose source folder";
                        enabled: !is-working;
                        pressed => {
                            root.select-input-folder();
                        }
                    }
                }
            }

            // ═══════════ OUTPUT ═══════════
            VerticalLayout {
                spacing: 0px;
                FieldGap { }

                Text {
                    text: is-encrypt-mode ? "Encrypted file" : "Output location";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                HorizontalLayout {
                    spacing: Theme.row-spacing;

                    Rectangle {
                        property <bool> field-enabled: !is-working && !(is-encrypt-mode && input-path == "");
                        horizontal-stretch: 1;
                        height: Theme.field-height;
                        border-radius: Theme.radius-lg;
                        background: !field-enabled ? Theme.input-bg-disabled : Theme.input-bg;
                        border-width: Theme.hairline;
                        border-color: field-enabled && out-ta.has-hover ? Theme.border-hover : Theme.border;
                        clip: true;
                        animate background { duration: Theme.dur-base; }
                        animate border-color { duration: Theme.dur-base; }

                        out-ta := TouchArea {
                            enabled: parent.field-enabled;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => {
                                if (is-encrypt-mode) {
                                    root.select-output-file();
                                } else {
                                    root.select-output-dir();
                                }
                            }
                        }

                        Text {
                            x: Theme.field-pad;
                            width: parent.width - 2 * Theme.field-pad;
                            vertical-alignment: center;
                            text: output-path != "" ? output-path-display : "No destination selected";
                            color: output-path != "" ? Theme.text : Theme.text-disabled;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                    }

                    SmallButton {
                        width: Theme.btn-width;
                        label: "Choose";
                        accessible-label: is-encrypt-mode ? "Choose where to save the encrypted file" : "Choose output location";
                        enabled: !is-working && !(is-encrypt-mode && input-path == "");
                        pressed => {
                            if (is-encrypt-mode) {
                                root.select-output-file();
                            } else {
                                root.select-output-dir();
                            }
                        }
                    }
                }
            }

            // ═══════════ DIVIDER ═══════════
            VerticalLayout {
                spacing: 0px;
                FieldGap {
                    gap: Theme.gap-2xl;
                    least: Theme.gap-lg;
                }

                Rectangle {
                    height: Theme.hairline;
                    background: Theme.border;
                }
            }

            // ═══════════ KEY PAIR SECTION ═══════════
            if mode == Mode.recipient-encrypt || mode == Mode.keygen: VerticalLayout {
                spacing: 0px;
                FieldGap { }

                Text {
                    text: "Key source";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                Rectangle {
                    height: Theme.ctl-height;
                    border-radius: Theme.radius-md;
                    background: Theme.surface;
                    border-width: Theme.hairline;
                    border-color: Theme.border;
                    accessible-role: tab-list;
                    accessible-label: "Key source";

                    HorizontalLayout {
                        padding: Theme.gap-2xs;
                        spacing: Theme.gap-2xs;

                        existing-key-choice := Choice {
                            label: "Use existing public key";
                            active: mode == Mode.recipient-encrypt;
                            enabled: !is-working;
                            border-radius: Theme.radius-sm;
                            chosen => {
                                root.choose-mode(Mode.recipient-encrypt);
                            }
                        }

                        Rectangle {
                            width: Theme.hairline;
                            background: Theme.border;
                        }

                        new-key-choice := Choice {
                            label: "Create key pair";
                            active: mode == Mode.keygen;
                            enabled: !is-working;
                            border-radius: Theme.radius-sm;
                            chosen => {
                                root.choose-mode(Mode.keygen);
                            }
                        }
                    }
                }
            }

            // ═══════════ KEY FILE (HE, HD) ═══════════
            if require-key: VerticalLayout {
                spacing: 0px;
                FieldGap { }

                Text {
                    text: mode == Mode.recipient-encrypt ? "Public key" : "Private key";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                HorizontalLayout {
                    spacing: Theme.row-spacing;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.field-height;
                        border-radius: Theme.radius-lg;
                        background: is-working ? Theme.input-bg-disabled : Theme.input-bg;
                        border-width: Theme.hairline;
                        border-color: !is-working && key-ta.has-hover ? Theme.border-hover : Theme.border;
                        clip: true;
                        animate background { duration: Theme.dur-base; }
                        animate border-color { duration: Theme.dur-base; }

                        key-ta := TouchArea {
                            enabled: !is-working;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => {
                                root.select-key-file();
                            }
                        }

                        Text {
                            x: Theme.field-pad;
                            width: parent.width - 2 * Theme.field-pad;
                            vertical-alignment: center;
                            text: key-path != "" ? key-path-display : (mode == Mode.recipient-encrypt ? "No public key selected" : "No private key selected");
                            color: key-path != "" ? Theme.text : Theme.text-disabled;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                    }

                    SmallButton {
                        width: Theme.btn-width;
                        label: "Choose";
                        accessible-label: mode == Mode.recipient-encrypt ? "Choose public key" : "Choose private key";
                        enabled: !is-working;
                        pressed => {
                            root.select-key-file();
                        }
                    }
                }

                if mode == Mode.recipient-encrypt && key-fingerprint != "": VerticalLayout {
                    property <bool> fp-copied: false;
                    spacing: 0px;
                    FieldGap { }

                    Text {
                        text: "Fingerprint";
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                    }

                    Rectangle {
                        height: Theme.label-gap;
                    }

                    fp-field := Rectangle {
                        height: Theme.ctl-height;
                        border-radius: Theme.radius-lg;
                        background: Theme.info-bg;
                        border-width: Theme.hairline;
                        border-color: Theme.info-border;

                        HorizontalLayout {
                            padding-left: Theme.field-pad;
                            padding-right: Theme.gap-sm;
                            spacing: Theme.gap-sm;

                            Text {
                                text: key-fingerprint;
                                color: Theme.text-dim;
                                font-size: Theme.font-caption;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            fp-copy-ta := Pressable {
                                width: Theme.icon-btn;
                                height: Theme.icon-btn;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-sm;
                                background: self.has-hover ? Theme.surface-hover : transparent;
                                accessible-label: fp-copied ? "Fingerprint copied" : "Copy fingerprint";
                                animate background { duration: Theme.dur-fast; }
                                pressed => {
                                    root.copy-fingerprint();
                                    fp-copied = true;
                                    fp-copied-timer.running = true;
                                }

                                fp-copied-timer := Timer {
                                    interval: 2s;
                                    running: false;
                                    triggered => {
                                        fp-copied = false;
                                        self.running = false;
                                    }
                                }

                                // Drawn rather than taken from a font, which may
                                // lack the glyph: two overlapping sheets, and a
                                // tick once the fingerprint is copied.
                                Path {
                                    width: Theme.icon;
                                    height: Theme.icon;
                                    viewbox-width: 11;
                                    viewbox-height: 11;
                                    commands: fp-copied ? "M 1 6 L 4 9 L 10 2" : "M 3.5 3.5 V 0.75 H 10.25 V 7.5 H 7.5 M 0.75 3.5 H 7.5 V 10.25 H 0.75 Z";
                                    stroke: fp-copied ? Theme.success : Theme.text-dim;
                                    stroke-width: Theme.icon-stroke;
                                    animate stroke { duration: Theme.dur-slow; }
                                }
                            }
                        }
                    }
                }
            }

            // ═══════════ KEY PAIR OUTPUT DIR (GK only) ═══════════
            if mode == Mode.keygen: VerticalLayout {
                spacing: 0px;
                FieldGap { }

                Text {
                    text: "Key pair folder";
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                HorizontalLayout {
                    spacing: Theme.row-spacing;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.field-height;
                        border-radius: Theme.radius-lg;
                        background: is-working ? Theme.input-bg-disabled : Theme.input-bg;
                        border-width: Theme.hairline;
                        border-color: !is-working && kgout-ta.has-hover ? Theme.border-hover : Theme.border;
                        clip: true;
                        animate background { duration: Theme.dur-base; }
                        animate border-color { duration: Theme.dur-base; }

                        kgout-ta := TouchArea {
                            enabled: !is-working;
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => {
                                root.select-keygen-output-dir();
                            }
                        }

                        Text {
                            x: Theme.field-pad;
                            width: parent.width - 2 * Theme.field-pad;
                            vertical-alignment: center;
                            text: keygen-output-dir != "" ? keygen-output-dir-display : "No folder selected";
                            color: keygen-output-dir != "" ? Theme.text : Theme.text-disabled;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }
                    }

                    SmallButton {
                        width: Theme.btn-width;
                        label: "Choose";
                        accessible-label: "Choose key pair folder";
                        enabled: !is-working;
                        pressed => {
                            root.select-keygen-output-dir();
                        }
                    }
                }
            }

            // ═══════════ PASSWORD (SE, SD, HD, GK) ═══════════
            if require-password: VerticalLayout {
                spacing: 0px;
                FieldGap { }

                Text {
                    text: password-name;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                Rectangle {
                    height: Theme.field-height;
                    border-radius: Theme.radius-lg;
                    background: is-working ? Theme.input-bg-disabled : Theme.input-bg;
                    border-width: Theme.hairline;
                    border-color: pwd-ti.has-focus ? Theme.border-focus : pwd-hover.has-hover && !is-working ? Theme.border-hover : Theme.border;
                    animate background { duration: Theme.dur-base; }
                    animate border-color { duration: Theme.dur-base; }

                    pwd-hover := TouchArea {
                        enabled: !is-working;
                        mouse-cursor: text;
                        clicked => {
                            pwd-ti.focus();
                        }
                    }

                    pwd-ti := PasswordInput {
                        x: Theme.field-pad;
                        width: parent.width - 40px;
                        height: parent.height;
                        text <=> root.password;
                        label: password-name;
                        masked: hide-password;
                        enabled: !is-working;
                        selection-clipboard: root.selection-clipboard;
                        accepted => {
                            if (!root.disable-start) {
                                root.start-operation();
                            }
                        }
                        edited => {
                            root.password-edited();
                        }
                    }

                    if password == "" && !pwd-ti.has-focus: Text {
                        x: Theme.field-pad;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "Enter " + password-noun;
                        color: Theme.text-disabled;
                        font-size: Theme.font-body;
                        accessible-role: none;
                    }

                    // Eye icon (toggle password visibility)
                    eye := Rectangle {
                        x: parent.width - 32px;
                        y: (parent.height - 14px) / 2;
                        width: 22px;
                        height: 14px;

                        property <color> ink: is-working ? Theme.text-off : Theme.text-dim;

                        // Eye outline (oval)
                        Rectangle {
                            width: 18px;
                            height: 10px;
                            x: 2px;
                            y: 2px;
                            border-radius: Theme.radius-md;
                            border-width: 1.5px;
                            border-color: eye.ink;
                            background: transparent;

                            // Pupil
                            Rectangle {
                                width: 5px;
                                height: 5px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 2.5px;
                                background: eye.ink;
                            }
                        }

                        // Strike-through (when password is visible)
                        if (!root.hide-password): Rectangle {
                            width: 22px;
                            height: 1.5px;
                            y: (parent.height - self.height) / 2;
                            background: eye.ink;
                        }
                    }

                    // The button over the eye
                    Pressable {
                        x: parent.width - 38px;
                        width: 38px;
                        height: parent.height;
                        enabled: !is-working;
                        ring-inset: Theme.gap-sm;
                        accessible-label: "Show " + password-noun;
                        accessible-checkable: true;
                        accessible-checked: !root.hide-password;
                        pressed => {
                            root.hide-password = !root.hide-password;
                        }
                    }
                }

                // Password strength indicator (encrypt/keygen only)
                if mode == Mode.passphrase-encrypt || mode == Mode.keygen: HorizontalLayout {
                    spacing: Theme.gap-sm;
                    height: 14px;

                    property <bool> active: password != "";

                    HorizontalLayout {
                        spacing: Theme.gap-2xs;
                        horizontal-stretch: 1;
                        padding-top: Theme.label-gap;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 2px;
                            border-radius: 1px;
                            background: active && password-strength >= 1 ? strength-color : Theme.surface;
                            animate background { duration: Theme.dur-slow; }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 2px;
                            border-radius: 1px;
                            background: active && password-strength >= 2 ? strength-color : Theme.surface;
                            animate background { duration: Theme.dur-slow; }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 2px;
                            border-radius: 1px;
                            background: active && password-strength >= 3 ? strength-color : Theme.surface;
                            animate background { duration: Theme.dur-slow; }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 2px;
                            border-radius: 1px;
                            background: active && password-strength >= 4 ? strength-color : Theme.surface;
                            animate background { duration: Theme.dur-slow; }
                        }
                    }

                    Text {
                        width: Theme.strength-label-w;
                        text: active ? (password-strength == 1 ? "Weak" : password-strength == 2 ? "Fair" : password-strength == 3 ? "Good" : "Strong") : "";
                        color: strength-color;
                        font-size: Theme.font-caption;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // ═══════════ CONFIRM PASSWORD (SE, GK — only when pwd hidden) ═══════════
            if require-password-repeated: VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: Theme.gap-md;
                }

                Text {
                    text: confirm-password-name;
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }

                Rectangle {
                    height: Theme.label-gap;
                }

                Rectangle {
                    property <bool> field-enabled: !is-working && password != "";
                    height: Theme.field-height;
                    border-radius: Theme.radius-lg;
                    background: !field-enabled ? Theme.input-bg-disabled : Theme.input-bg;
                    border-width: Theme.hairline;
                    border-color: rpwd-ti.has-focus ? Theme.border-focus : rpwd-hover.has-hover && field-enabled ? Theme.border-hover : Theme.border;
                    animate background { duration: Theme.dur-base; }
                    animate border-color { duration: Theme.dur-base; }

                    rpwd-hover := TouchArea {
                        enabled: parent.field-enabled;
                        mouse-cursor: self.enabled ? text : default;
                        clicked => {
                            rpwd-ti.focus();
                        }
                    }

                    rpwd-ti := PasswordInput {
                        x: Theme.field-pad;
                        width: parent.width - 36px;
                        height: parent.height;
                        text <=> root.password-repeated;
                        label: confirm-password-name;
                        enabled: parent.field-enabled;
                        selection-clipboard: root.selection-clipboard;
                        accepted => {
                            if (!root.disable-start) {
                                root.start-operation();
                            }
                        }
                        edited => {
                            root.form-edited();
                        }
                    }

                    if password-repeated == "" && !rpwd-ti.has-focus: Text {
                        x: Theme.field-pad;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "Re-enter " + password-noun;
                        color: Theme.text-disabled;
                        font-size: Theme.font-body;
                        accessible-role: none;
                    }

                    // A check or a cross, so the shape tells a match apart
                    // without the colour.
                    if password-repeated != "": Path {
                        x: parent.width - 17px - self.width / 2;
                        y: (parent.height - self.height) / 2;
                        width: Theme.icon;
                        height: Theme.icon;
                        viewbox-width: 11;
                        viewbox-height: 11;
                        commands: password-match ? "M 1 6 L 4 9 L 10 2" : "M 2 2 L 9 9 M 9 2 L 2 9";
                        stroke: password-match ? Theme.success : Theme.error;
                        stroke-width: Theme.match-stroke;
                        accessible-role: image;
                        accessible-label: password-match ? "Passwords match" : "Passwords do not match";
                        animate stroke { duration: Theme.dur-slow; }
                    }
                }
            }
        } // end top section

        // ── Spacer: pushes bottom section to a fixed position ──
        Rectangle {
            // Keeps the bar off the last field; with flexible gaps, the gaps above
            // shrink instead. With rigid gaps, Create key pair leaves little more
            // than this, so the bar cannot grow onto the last field.
            min-height: Theme.flexible-gaps ? Theme.gap-lg : Theme.gap-sm;
            vertical-stretch: 1;
        }

        // ── Bottom section: always at the same position ──

        // ═══════════ NOTIFICATION BAR ═══════════
        // Priority: error > warning > success/progress > "Ready". Only one shown at a time.
        // The bar grows upward into the spacer to fit a wrapped message and
        // shrinks back to one line when the mode above leaves no room. Its
        // stretch makes the layout shrink it before the form's gaps. With
        // rigid gaps the form cannot shrink, so the stretch changes nothing.
        Rectangle {
            property <bool> show-ready: !is-working && status-err == "" && conflict-warning == "" && status-ok == "";
            vertical-stretch: 1;
            min-height: Theme.ctl-height;
            preferred-height: max(Theme.ctl-height, notify-text.preferred-height + 2 * Theme.notify-pad);
            max-height: self.preferred-height;
            border-radius: Theme.radius-lg;
            background: status-err != "" ? Theme.notify-error-bg : conflict-warning != "" ? Theme.notify-warning-bg : (status-ok != "" || show-ready) ? Theme.notify-success-bg : transparent;
            border-width: (status-err != "" || conflict-warning != "" || status-ok != "" || show-ready) ? Theme.hairline : 0px;
            border-color: status-err != "" ? Theme.notify-error-border : conflict-warning != "" ? Theme.notify-warning-border : (status-ok != "" || show-ready) ? Theme.notify-success-border : transparent;
            animate background { duration: Theme.dur-slow; }
            animate border-color { duration: Theme.dur-slow; }
            // Keeps the progress fill inside the rounded corners.
            clip: true;

            // Fills from the left, behind the text, as the operation goes.
            if is-working && progress >= 0: Rectangle {
                x: 0;
                width: parent.width * clamp(progress, 0, 1);
                background: Theme.notify-success-border;
                accessible-role: progress-indicator;
                accessible-label: "Progress";
                accessible-value: clamp(progress, 0, 1);
                accessible-value-minimum: 0;
                accessible-value-maximum: 1;
                animate width { duration: Theme.dur-slow; }
            }

            // Full height, so a single line always has room to render even
            // when the bar is shrunk to its minimum; the padding lives in the
            // bar's preferred height above. When the bar cannot show every
            // line, the text starts at the top: the first line, which says
            // what went wrong, stays, and the last one shown ends in "…".
            notify-text := Text {
                x: Theme.field-pad;
                width: parent.width - 2 * Theme.field-pad;
                height: parent.height;
                vertical-alignment: self.preferred-height > self.height ? TextVerticalAlignment.top : TextVerticalAlignment.center;
                text: status-err != "" ? status-err : conflict-warning != "" ? conflict-warning : status-ok != "" ? status-ok : show-ready ? "Ready" : "";
                color: status-err != "" ? Theme.error : conflict-warning != "" ? Theme.warning : Theme.success;
                font-size: Theme.font-body;
                wrap: word-wrap;
                overflow: elide;
                // Assistive technology reads each new message out.
                accessible-live-region: polite;
            }
        }

        Rectangle {
            height: Theme.gap-lg;
        }

        // ═══════════ ACTION ROW ═══════════
        HorizontalLayout {
            spacing: Theme.gap-md;

            reset-ta := Pressable {
                width: Theme.reset-width;
                height: Theme.action-height;
                enabled: !form-is-clean && !is-working;
                border-radius: Theme.radius-lg;
                background: self.has-hover ? Theme.surface-hover : transparent;
                border-width: self.enabled ? Theme.hairline : 0px;
                border-color: Theme.border;
                accessible-label: "Reset";
                animate background { duration: Theme.dur-fast; }
                animate border-width { duration: Theme.dur-fast; }
                pressed => {
                    root.clear-form();
                }

                Text {
                    text: "Reset";
                    color: reset-ta.enabled ? Theme.text-dim : Theme.text-off;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            start-ta := Pressable {
                horizontal-stretch: 1;
                height: Theme.action-height;
                enabled: !disable-start;
                border-radius: Theme.radius-lg;
                background: disable-start ? Theme.surface : self.has-hover ? Theme.accent-btn-hover : Theme.accent-btn;
                // The usual ring would hardly show on the accent colour.
                ring-color: Theme.text;
                accessible-label: button-text;
                animate background { duration: Theme.dur-fast; }
                pressed => {
                    root.start-operation();
                }

                Text {
                    text: button-text;
                    color: disable-start ? Theme.text-disabled : Theme.text;
                    font-size: Theme.font-action;
                    font-weight: Theme.weight-medium;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }

        Rectangle {
            height: Theme.field-pad;
        }
    }

    // ── Own frame: outline, drawn over the content ──────────────────────
    if own-frame: Rectangle {
        border-radius: Theme.window-radius;
        border-width: Theme.hairline;
        border-color: Theme.border-hover;
    }
}
